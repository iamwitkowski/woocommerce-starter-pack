{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"viewport": {
			"mobile": "480px",
			"tablet": "782px"
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "background", "name": "Background", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f5f5f4" },
				{ "slug": "text", "name": "Text", "color": "#1c1917" },
				{ "slug": "muted", "name": "Muted", "color": "#57534e" },
				{ "slug": "primary", "name": "Primary", "color": "#1c1917" },
				{ "slug": "on-primary", "name": "On primary", "color": "#ffffff" },
				{ "slug": "secondary", "name": "Secondary", "color": "#44403c" },
				{ "slug": "accent", "name": "Accent", "color": "#b45309" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System sans-serif",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "system-mono",
					"name": "System monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "1.875rem", "fluid": { "min": "1.5rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "2X large", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.5rem" } },
				{ "slug": "xxx-large", "name": "3X large", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "em", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "20", "name": "2X small", "size": "0.5rem" },
				{ "slug": "30", "name": "X small", "size": "0.75rem" },
				{ "slug": "40", "name": "Small", "size": "1rem" },
				{ "slug": "50", "name": "Medium", "size": "clamp(1.25rem, 3vw, 2rem)" },
				{ "slug": "60", "name": "Large", "size": "clamp(2rem, 5vw, 3rem)" },
				{ "slug": "70", "name": "X large", "size": "clamp(3rem, 7vw, 5rem)" },
				{ "slug": "80", "name": "2X large", "size": "clamp(4rem, 10vw, 7.5rem)" }
			]
		},
		"border": {
			"radiusSizes": [
				{ "slug": "none", "name": "None", "size": "0" },
				{ "slug": "small", "name": "Small", "size": "4px" },
				{ "slug": "medium", "name": "Medium", "size": "8px" },
				{ "slug": "large", "name": "Large", "size": "16px" },
				{ "slug": "full", "name": "Full", "size": "9999px" }
			]
		},
		"custom": {
			"radius": {
				"control": "var(--wp--preset--border-radius--small)",
				"button": "var(--wp--preset--border-radius--medium)",
				"card": "var(--wp--preset--border-radius--medium)"
			},
			"focus": {
				"width": "2px",
				"offset": "2px"
			},
			"line-height": {
				"body": "1.6",
				"heading": "1.2"
			},
			"transition": "150ms ease"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "var(--wp--custom--line-height--body)"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"left": "var:preset|spacing|50",
				"right": "var:preset|spacing|50"
			}
		},
		"elements": {
			"heading": {
				"color": { "text": "var:preset|color|text" },
				"typography": {
					"fontWeight": "600",
					"lineHeight": "var(--wp--custom--line-height--heading)"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|xxx-large", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "letterSpacing": "-0.01em" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"h5": { "typography": { "fontSize": "var:preset|font-size|medium" } },
			"h6": { "typography": { "fontSize": "var:preset|font-size|small", "textTransform": "uppercase", "letterSpacing": "0.05em" } },
			"link": {
				"color": { "text": "var:preset|color|primary" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "none" }
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|on-primary"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button)",
					"width": "0"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|30",
						"bottom": "var:preset|spacing|30",
						"left": "var:preset|spacing|50",
						"right": "var:preset|spacing|50"
					}
				},
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|secondary",
						"text": "var:preset|color|on-primary"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|text",
						"offset": "var(--wp--custom--focus--offset)",
						"style": "solid",
						"width": "var(--wp--custom--focus--width)"
					}
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/separator": {
				"color": { "text": "var:preset|color|muted" }
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|primary",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": { "left": "var:preset|spacing|40" }
				}
			},
			"core/code": {
				"color": { "background": "var:preset|color|surface" },
				"typography": { "fontFamily": "var:preset|font-family|system-mono", "fontSize": "var:preset|font-size|small" },
				"border": { "radius": "var(--wp--custom--radius--control)" },
				"spacing": { "padding": { "top": "var:preset|spacing|40", "bottom": "var:preset|spacing|40", "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" } }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/site-title": {
				"typography": { "fontWeight": "700", "fontSize": "var:preset|font-size|large" },
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|text" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						":hover": { "typography": { "textDecoration": "underline" } }
					}
				}
			}
		}
	}
}

{
	"name": "starter-pack",
	"version": "0.1.0",
	"private": true,
	"description": "Fast, block-based WooCommerce starter theme.",
	"engines": {
		"node": ">=22.22.2"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:seed": "wp-env run cli wp eval-file wp-content/themes/starter-pack/bin/seed.php",
		"lint:js": "wp-scripts lint-js tests playwright.config.mjs",
		"lint:php": "composer run lint",
		"analyse:php": "composer run analyse",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@wordpress/env": "12.0.0",
		"@wordpress/scripts": "37.0.0"
	}
}

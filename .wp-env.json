{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"port": 8890,
	"testsEnvironment": false,
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip",
		"https://downloads.wordpress.org/plugin/wordpress-importer.latest-stable.zip"
	],
	"themes": [],
	"mappings": {
		"wp-content/themes/starter-pack": "."
	},
	"config": {
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": false,
		"WP_DEVELOPMENT_MODE": "theme",
		"AUTOMATIC_UPDATER_DISABLED": true
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp eval-file wp-content/themes/starter-pack/bin/seed.php"
	}
}

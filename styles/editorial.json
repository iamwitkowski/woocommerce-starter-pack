{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"title": "Editorial",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "background",
					"name": "Background",
					"color": "#faf7f2"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#f1ebe1"
				},
				{
					"slug": "text",
					"name": "Text",
					"color": "#2b2118"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#6b5d4f"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#7c2d12"
				},
				{
					"slug": "on-primary",
					"name": "On primary",
					"color": "#faf7f2"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#5a1f0c"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#9a3412"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "system-sans",
					"name": "System sans-serif",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "system-mono",
					"name": "System monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				},
				{
					"slug": "fraunces",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/fraunces/fraunces-latin-wght-normal.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/fraunces/fraunces-latin-ext-wght-normal.woff2"
							],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			]
		},
		"custom": {
			"radius": {
				"control": "var(--wp--preset--border-radius--none)",
				"button": "var(--wp--preset--border-radius--none)",
				"card": "var(--wp--preset--border-radius--none)"
			}
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|fraunces",
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|fraunces"
				}
			}
		}
	}
}

{
	"name": "starter-pack/theme",
	"description": "Fast, block-based WooCommerce starter theme. Composer is used for development tooling only.",
	"type": "wordpress-theme",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"php-stubs/woocommerce-stubs": "^11.2",
		"phpstan/phpstan": "^2.3",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"config": {
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"analyse": "phpstan analyse --memory-limit=1G"
	}
}
